# ==============================================================================
# SatQuery AI — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Ollama / Local LLM Reasoning Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Neural Text-To-Speech (Kokoro-82M)
KOKORO_MODEL_PATH=checkpoints/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=checkpoints/kokoro/voices-v1.0.bin
TTS_DEFAULT_VOICE=af_heart

# Vision Model Execution Settings
# Set to 'true' only if you wish to eagerly load and warm up Qwen2-VL into VRAM at startup.
# Recommended: 'false' for fast boot, lazy on-demand loading, and low memory instances.
ENABLE_MODEL_WARMUP=false
QWEN_MODEL_PATH=Qwen2-VL-2B-Instruct
QWEN_DEVICE=auto

# Optional Geospatial & API Tokens (Placeholders)
# HUGGINGFACE_TOKEN=your_huggingface_token_here
